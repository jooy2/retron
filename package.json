{
  "name": "retron",
  "appId": "com.retron.retron",
  "version": "1.0.0",
  "description": "ViteJS + Electron + React + Material Plus Template",
  "homepage": "https://github.com/jooy2/retron",
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "main": "dist/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/retron.git"
  },
  "bugs": {
    "url": "https://github.com/jooy2/retron/issues"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://localhost:5173"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "vite -d",
    "dev:debug:force": "vite -d --force",
    "build": "npm run build:pre && electron-builder --config=buildAssets/builder/config.ts",
    "build:pre": "tsc -b && vite build",
    "build:all": "npm run build:pre && electron-builder -wml --config=buildAssets/builder/config.ts",
    "build:dir": "npm run build:pre && electron-builder --dir --config=buildAssets/builder/config.ts",
    "build:win": "npm run build:pre && electron-builder --windows --config=buildAssets/builder/config.ts",
    "build:win:portable": "npm run build:pre && electron-builder --windows nsis:x64 portable --config=buildAssets/builder/config.ts",
    "build:mac": "npm run build:pre && electron-builder --mac --config=buildAssets/builder/config.ts",
    "build:linux": "npm run build:pre && electron-builder --linux --config=buildAssets/builder/config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "npm run build:pre && playwright test",
    "test:linux": "npm run build:pre && xvfb-run --auto-servernum --server-args='-screen 0, 1280x960x24' -- playwright test"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron/devtron": "^2.1.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "^1.64.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "dotenv": "^18.0.9",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-extension-installer": "^2.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "jiti": "^2.7.0",
    "material-plus-ui": "^1.11.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2"
  }
}
